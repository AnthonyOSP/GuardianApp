# Copia este archivo a ".env" para correr el backend en tu máquina (Render
# no lee este archivo; ahí las variables se configuran en el dashboard, ver
# backend/README.md). ".env" está en .gitignore — nunca lo subas a git.

# Clave compartida que Android debe enviar en el header "X-API-Key".
# Generarla con: openssl rand -hex 32
# Protección TEMPORAL únicamente (ver src/middleware/apiKey.js) hasta que
# exista Firebase Authentication.
EVENTS_API_KEY=

# Ruta a un archivo JSON de cuenta de servicio de Firebase (Admin SDK), SOLO
# para desarrollo local. NUNCA pongas ese archivo dentro del repo (está en
# .gitignore por si acaso). En Render se usa un Secret File en vez de esta
# variable — ver backend/README.md.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Puerto local (Render inyecta su propio PORT en producción).
PORT=8080
