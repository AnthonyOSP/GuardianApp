<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth: Android 11 (API 30) y anteriores.
         BLUETOOTH/BLUETOOTH_ADMIN son permisos "normales" (se conceden solo
         por instalar). ACCESS_FINE_LOCATION sí se debe pedir en tiempo de
         ejecución: es obligatorio para poder escanear BLE en estas versiones. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Bluetooth: Android 12 (API 31) y superiores. Permisos nuevos en
         tiempo de ejecución. neverForLocation porque no derivamos ubicación
         física de los resultados del escaneo, solo buscamos el ESP32. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Fase 4: enviar eventos a Cloud Firestore por Internet.
         ACCESS_NETWORK_STATE es un permiso "normal" (sin diálogo en tiempo
         de ejecución); lo usamos para detectar "sin conexión" antes de
         intentar escribir en Firestore, en vez de esperar un timeout. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Fase 5: mostrar notificaciones FCM. Runtime permission solo desde
         Android 13 (API 33/TIRAMISU); en versiones anteriores se concede
         automáticamente y no hace falta pedirlo (ver ApoderadoScreen.kt,
         needsNotificationsPermission()). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La app debe poder instalarse igual en equipos sin BLE; simplemente
         la funcionalidad de la pantalla Usuario quedará deshabilitada. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardianApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fase 5: recibe los mensajes de Firebase Cloud Messaging. -->
        <service
            android:name=".fcm.GuardianFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canal usado cuando Android muestra la notificación por su
             cuenta (app en segundo plano/cerrada). Debe coincidir con
             GuardianNotifications.CHANNEL_ID. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="guardian_events" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

    </application>

</manifest>