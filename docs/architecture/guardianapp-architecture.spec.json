  "cards": [
    {
      "dot": "cyan",
      "title": "Alert delivery path",
      "items": [
        "Trigger: a real ESP32 GATT event, or a manual EMERGENCY / FOOD / BATHROOM / HELP button - same path either way.",
        "Each event fans out independently: a direct Firestore write plus the HTTPS POST to the backend; one can fail without the other."
      ]
    },
    {
      "dot": "amber",
      "title": "Pairing + identity (no Firebase Auth yet)",
      "items": [
        "LocalIdentity keeps anonymous SharedPreferences IDs: usuarioId (6-char code) and apoderadoId (UUID); the POST body carries usuarioId.",
        "Backend reads vinculaciones + apoderadoTokens, resolves usuarioId to the linked guardian, and multicasts - never a broadcast."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "The APK ships only X-API-Key, a shared secret (extractable, R8 disabled) - not authentication; slated for Firebase Auth.",
        "The backend alone holds the Firebase Admin SDK key and bypasses Firestore rules. Foreground vs background only changes who renders the notification."
      ]
    }
  ]
